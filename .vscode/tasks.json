{
  "version": "2.0.0",
  "tasks": [
    { "label": "zcodePool:build", "type": "process", "command": "npm", "args": ["--prefix", "extensions/vscode", "run", "build"], "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": "$tsc", "group": { "kind": "build", "isDefault": true } },
    { "label": "zcodePool:watch", "type": "process", "command": "npm", "args": ["--prefix", "extensions/vscode", "run", "watch"], "options": { "cwd": "${workspaceFolder}" }, "isBackground": true, "problemMatcher": { "base": "$tsc", "background": { "activeOnStart": true, "beginsPattern": "^\\[zcodePool-watch\\] build started$", "endsPattern": "^\\[zcodePool-watch\\] build finished$" } } }
  ]
}

+    if (ratio < need) out.push({ text: el.textContent.trim().slice(0, 30), cls: `${el.tagName}.${el.className}`.slice(0, 60), ratio: +ratio.toFixed(2), fg: cs.color, size });
+  }
+  return out;
+}
